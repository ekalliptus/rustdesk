---
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("eldesk-theme");
          var prefersDark =
            window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme = stored === "dark" || stored === "light" ? stored : prefersDark ? "dark" : "light";
          document.documentElement.dataset.theme = theme;
        } catch (_err) {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="border-b border-[var(--border)] bg-[var(--surface)]">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
        <a
          href="/"
          class="inline-flex min-h-11 items-center gap-2.5 text-base font-bold tracking-tight text-[var(--text)] no-underline"
        >
          <span
            aria-hidden="true"
            class="inline-flex h-7 w-7 items-center justify-center rounded-[4px] bg-[var(--accent)] font-mono text-xs font-bold text-[var(--accent-fg)]"
          >
            EL
          </span>
          <span>EL-Desk</span>
        </a>

        <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
          <a
            href="/#downloads"
            class="inline-flex min-h-11 items-center rounded-[4px] px-3 text-sm font-medium text-[var(--text)] hover:bg-[var(--surface-subtle)] no-underline"
          >
            Downloads
          </a>
          <a
            href="/#changelog"
            class="inline-flex min-h-11 items-center rounded-[4px] px-3 text-sm font-medium text-[var(--text)] hover:bg-[var(--surface-subtle)] no-underline"
          >
            Changelog
          </a>
          <a
            href="/#infrastructure"
            class="inline-flex min-h-11 items-center rounded-[4px] px-3 text-sm font-medium text-[var(--text)] hover:bg-[var(--surface-subtle)] no-underline"
          >
            Infrastructure
          </a>
          <a
            href="/privacy"
            aria-current={currentPath === "/privacy" ? "page" : undefined}
            class="inline-flex min-h-11 items-center rounded-[4px] px-3 text-sm font-medium text-[var(--text)] hover:bg-[var(--surface-subtle)] no-underline"
          >
            Privacy
          </a>
        </nav>

        <div class="flex items-center gap-2">
          <button
            id="theme-toggle"
            type="button"
            class="inline-flex min-h-11 items-center justify-center rounded-[6px] border border-[var(--border-strong)] bg-[var(--surface)] px-3 text-xs font-semibold text-[var(--text)] hover:bg-[var(--surface-subtle)] active:bg-[var(--border)]"
            aria-pressed="false"
            aria-label="Toggle color theme"
          >
            <span id="theme-toggle-label">Theme: Light</span>
          </button>

          <button
            id="menu-toggle"
            type="button"
            class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-[6px] border border-[var(--border-strong)] bg-[var(--surface)] px-3 text-xs font-semibold text-[var(--text)] hover:bg-[var(--surface-subtle)] md:hidden"
            aria-expanded="false"
            aria-controls="mobile-nav"
            aria-label="Toggle navigation menu"
          >
            Menu
          </button>
        </div>
      </div>

      <nav
        id="mobile-nav"
        aria-label="Mobile navigation"
        hidden
        class="border-t border-[var(--border)] bg-[var(--surface)] px-4 py-3 md:hidden"
      >
        <div class="flex flex-col gap-1">
          <a
            href="/#downloads"
            class="inline-flex min-h-11 items-center rounded-[4px] px-3 text-sm font-medium text-[var(--text)] hover:bg-[var(--surface-subtle)] no-underline"
          >
            Downloads
          </a>
          <a
            href="/#changelog"
            class="inline-flex min-h-11 items-center rounded-[4px] px-3 text-sm font-medium text-[var(--text)] hover:bg-[var(--surface-subtle)] no-underline"
          >
            Changelog
          </a>
          <a
            href="/#infrastructure"
            class="inline-flex min-h-11 items-center rounded-[4px] px-3 text-sm font-medium text-[var(--text)] hover:bg-[var(--surface-subtle)] no-underline"
          >
            Infrastructure
          </a>
          <a
            href="/privacy"
            aria-current={currentPath === "/privacy" ? "page" : undefined}
            class="inline-flex min-h-11 items-center rounded-[4px] px-3 text-sm font-medium text-[var(--text)] hover:bg-[var(--surface-subtle)] no-underline"
          >
            Privacy
          </a>
        </div>
      </nav>
    </header>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-[var(--border)] bg-[var(--surface)]">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-6 text-xs text-[var(--text-muted)] sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
        <div>
          EL-Desk private deployment on <span class="font-mono text-[var(--text)]">desk.ekalliptus.com</span>, built from upstream{" "}
          <a
            href="https://github.com/rustdesk/rustdesk"
            rel="noopener noreferrer"
            class="text-[var(--accent)] underline underline-offset-4 hover:text-[var(--accent-hover)]"
          >
            RustDesk
          </a>
          .
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <a
            href="/#downloads"
            class="inline-flex min-h-11 items-center text-[var(--text)] underline underline-offset-4 hover:text-[var(--accent)]"
          >
            Downloads
          </a>
          <a
            href="/privacy"
            class="inline-flex min-h-11 items-center text-[var(--text)] underline underline-offset-4 hover:text-[var(--accent)]"
          >
            Privacy
          </a>
          <a
            href="https://dl.desk.ekalliptus.com/latest.json"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center text-[var(--text)] underline underline-offset-4 hover:text-[var(--accent)]"
          >
            latest.json
          </a>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var themeBtn = document.getElementById("theme-toggle");
        var themeLabel = document.getElementById("theme-toggle-label");
        var menuBtn = document.getElementById("menu-toggle");
        var mobileNav = document.getElementById("mobile-nav");

        function syncThemeButton() {
          var isDark = root.dataset.theme === "dark";
          if (themeBtn) {
            themeBtn.setAttribute("aria-pressed", isDark ? "true" : "false");
          }
          if (themeLabel) {
            themeLabel.textContent = isDark ? "Theme: Dark" : "Theme: Light";
          }
        }

        syncThemeButton();

        if (themeBtn) {
          themeBtn.addEventListener("click", function () {
            var next = root.dataset.theme === "dark" ? "light" : "dark";
            root.classList.add("theme-switching");
            root.dataset.theme = next;
            void root.offsetHeight;
            try {
              localStorage.setItem("eldesk-theme", next);
            } catch (_err) {
              // Ignore storage quota or private browsing errors.
            }
            syncThemeButton();
            requestAnimationFrame(function () {
              root.classList.remove("theme-switching");
            });
          });
        }

        function setMenuOpen(open) {
          if (!menuBtn || !mobileNav) return;
          menuBtn.setAttribute("aria-expanded", open ? "true" : "false");
          menuBtn.textContent = open ? "Close" : "Menu";
          mobileNav.hidden = !open;
        }

        if (menuBtn && mobileNav) {
          menuBtn.addEventListener("click", function () {
            var expanded = menuBtn.getAttribute("aria-expanded") === "true";
            setMenuOpen(!expanded);
          });

          mobileNav.querySelectorAll("a").forEach(function (link) {
            link.addEventListener("click", function () {
              setMenuOpen(false);
            });
          });

          document.addEventListener("keydown", function (event) {
            if (event.key === "Escape" && !mobileNav.hidden) {
              setMenuOpen(false);
              menuBtn.focus();
            }
          });
        }
      })();
    </script>
  </body>
</html>
