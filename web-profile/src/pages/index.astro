---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { DownloadPortal } from "@/components/DownloadPortal";
import { DEFAULT_LATEST_JSON_URL } from "@/lib/release";

const latestJsonUrl = import.meta.env.PUBLIC_LATEST_JSON_URL || DEFAULT_LATEST_JSON_URL;
---

<BaseLayout
  title="EL-Desk | Private Remote Desktop Downloads"
  description="Installers, SHA-256 checksums, release changelog, and service status for the private EL-Desk remote desktop fleet."
>
  <DownloadPortal client:load manifestUrl={latestJsonUrl}>
    <div class="space-y-4">
      <h1
        id="downloads-heading"
        class="text-[clamp(2.25rem,4.5vw,3.5rem)] font-bold leading-[1.06] tracking-[-0.03em] text-[var(--text)]"
      >
        Private remote desktop, built for{" "}
        <em class="font-serif font-normal italic text-[var(--accent-text)]">your fleet.</em>
      </h1>
      <p class="max-w-2xl text-base leading-relaxed text-[var(--text-muted)]">
        Fast, key-locked remote desktop access across Windows, Linux, macOS, and Android. Run
        unattended host sessions, transfer files, and control workstations from your phone over
        your dedicated private relay and account API.
      </p>
      <p class="max-w-2xl text-sm leading-relaxed text-[var(--text-muted)]">
        Installers never touch public RustDesk rendezvous servers. Every binary is verified with
        SHA-256 digests generated during the release build and served directly from Cloudflare R2.
      </p>
    </div>
  </DownloadPortal>

  <!-- Band 5: Inverted Deep-Slate Architecture Specification -->
  <section
    id="architecture"
    aria-labelledby="architecture-heading"
    class="inv-band border-t border-[var(--inv-border)] bg-[var(--inv-bg)] text-[var(--inv-text)]"
  >
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="space-y-3 lg:col-span-4">
          <div class="font-mono text-xs font-medium uppercase tracking-[0.1em] text-[var(--inv-accent)]">
            04 / Architecture
          </div>
          <h2
            id="architecture-heading"
            class="text-2xl font-semibold tracking-tight text-[var(--inv-text)] sm:text-3xl"
          >
            Infrastructure layout
          </h2>
          <p class="text-sm leading-relaxed text-[var(--inv-text-muted)]">
            Client binaries lock server identity at compile time. Rendezvous and relay traffic run
            directly on host networking without Cloudflare proxying, while account and address book
            state stays on the Go API backed by NeonDB.
          </p>
          <p class="text-sm leading-relaxed text-[var(--inv-text-muted)]">
            Heartbeat requests stay in memory with a 45-second TTL so NeonDB scales to zero between
            active sign-ins and address book edits.
          </p>
        </div>

        <div class="lg:col-span-8">
          <div class="hidden overflow-x-auto rounded-xl border border-[var(--inv-border)] bg-[var(--inv-surface)] sm:block">
            <table class="w-full border-collapse text-left text-sm">
              <thead>
                <tr class="border-b border-[var(--inv-border)] text-xs font-semibold text-[var(--inv-text-muted)]">
                  <th scope="col" class="px-4 py-3.5">Component</th>
                  <th scope="col" class="px-4 py-3.5">Hosting</th>
                  <th scope="col" class="px-4 py-3.5">Cloudflare mode</th>
                  <th scope="col" class="px-4 py-3.5">Responsibility</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[var(--inv-border)]">
                <tr>
                  <td class="px-4 py-3.5 font-medium text-[var(--inv-accent)]">
                    Web portal
                  </td>
                  <td class="px-4 py-3.5 text-[var(--inv-text)]">Cloudflare Pages</td>
                  <td class="px-4 py-3.5 text-[var(--inv-text-muted)]">Proxied</td>
                  <td class="px-4 py-3.5 text-[var(--inv-text-muted)]">
                    Static portal, checksums, privacy notice
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3.5 font-medium text-[var(--inv-accent)]">
                    Release CDN
                  </td>
                  <td class="px-4 py-3.5 text-[var(--inv-text)]">Cloudflare R2</td>
                  <td class="px-4 py-3.5 text-[var(--inv-text-muted)]">Proxied</td>
                  <td class="px-4 py-3.5 text-[var(--inv-text-muted)]">
                    Installers, APK packages, and release checksums
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3.5 font-medium text-[var(--inv-accent)]">
                    Account API
                  </td>
                  <td class="px-4 py-3.5 text-[var(--inv-text)]">Cloudflare Worker + VPS Caddy</td>
                  <td class="px-4 py-3.5 text-[var(--inv-text-muted)]">Proxied</td>
                  <td class="px-4 py-3.5 text-[var(--inv-text-muted)]">
                    Go API (auth, address book, audit, memory presence)
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3.5 font-medium text-[var(--inv-accent)]">
                    Rendezvous &amp; relay
                  </td>
                  <td class="px-4 py-3.5 text-[var(--inv-text)]">VPS Host Net</td>
                  <td class="px-4 py-3.5 text-[var(--inv-text-muted)]">DNS Only</td>
                  <td class="px-4 py-3.5 text-[var(--inv-text-muted)]">
                    hbbs and hbbr on TCP/UDP 21115 to 21119 (-k _)
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Mobile stacked specification list -->
          <dl class="space-y-3 sm:hidden">
            <div class="rounded-xl border border-[var(--inv-border)] bg-[var(--inv-surface)] p-4 space-y-1">
              <dt class="text-xs font-semibold text-[var(--inv-accent)]">
                Web portal
              </dt>
              <dd class="text-xs text-[var(--inv-text-muted)]">
                Cloudflare Pages (Proxied): Static portal, checksums, privacy notice.
              </dd>
            </div>
            <div class="rounded-xl border border-[var(--inv-border)] bg-[var(--inv-surface)] p-4 space-y-1">
              <dt class="text-xs font-semibold text-[var(--inv-accent)]">
                Release CDN
              </dt>
              <dd class="text-xs text-[var(--inv-text-muted)]">
                Cloudflare R2 (Proxied): Installers, APK packages, and release checksums.
              </dd>
            </div>
            <div class="rounded-xl border border-[var(--inv-border)] bg-[var(--inv-surface)] p-4 space-y-1">
              <dt class="text-xs font-semibold text-[var(--inv-accent)]">
                Account API
              </dt>
              <dd class="text-xs text-[var(--inv-text-muted)]">
                Cloudflare Worker + VPS Caddy (Proxied): Go API for auth, address book, audit,
                in-memory heartbeats.
              </dd>
            </div>
            <div class="rounded-xl border border-[var(--inv-border)] bg-[var(--inv-surface)] p-4 space-y-1">
              <dt class="text-xs font-semibold text-[var(--inv-accent)]">
                Rendezvous &amp; relay
              </dt>
              <dd class="text-xs text-[var(--inv-text-muted)]">
                VPS Host Net (DNS Only): hbbs and hbbr on TCP/UDP 21115 to 21119 (-k _).
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
