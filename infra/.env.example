# NeonDB PostgreSQL connection string MUST use the `-pooler` endpoint with sslmode=require
DATABASE_URL=postgres://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/eldesk?sslmode=require

# Minimum 32 random bytes: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes-secret

# Runtime tuning (defaults tuned for personal 1-5 users / 5-20 devices & Neon scale-to-zero)
PORT=21114
JWT_TTL_HOURS=168
PRESENCE_TTL_SECONDS=45
TRUST_PROXY=true

# Public endpoints for release metadata and CORS
RELEASE_CDN_BASE=https://dl.desk.ekalliptus.com
WEB_PROFILE_URL=https://desk.ekalliptus.com
ALLOWED_ORIGIN=https://desk.ekalliptus.com
